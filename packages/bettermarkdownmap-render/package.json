{
  "name": "bettermarkdownmap-render",
  "version": "0.18.12",
  "description": "Visualize your Markdown as mindmaps with BetterMarkdownMap",
  "author": "Gerald <gera2ld@live.com>",
  "license": "MIT",
  "scripts": {
    "clean": "del-cli dist tsconfig.tsbuildinfo",
    "build:types": "tsc",
    "build:js": "vite build",
    "build": "pnpm clean && pnpm /^build:/"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "markdown",
    "bettermarkdownmap",
    "mindmap"
  ],
  "devDependencies": {
    "d3": "^7.8.5",
    "bettermarkdownmap-common": "workspace:*",
    "bettermarkdownmap-view": "workspace:*"
  },
  "dependencies": {
    "@babel/runtime": "^7.22.6"
  },
  "peerDependencies": {
    "bettermarkdownmap-common": "*"
  }
}
