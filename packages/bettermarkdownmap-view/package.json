    "d3": "^7.8.5"
  },
  "devDependencies": {
    "@gera2ld/jsx-dom": "^2.2.2",
    "@types/d3": "^7.4.0",
    "@types/d3-flextree": "^2.1.1",
    "d3-flextree": "^2.1.2",
    "bettermarkdownmap-common": "workspace:*"
  },
  "peerDependencies": {
    "bettermarkdownmap-common": "*"
  }
